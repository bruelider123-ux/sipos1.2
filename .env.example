# Copiar este archivo como ".env" y completar los valores.
# El archivo ".env" real NUNCA debe subirse a un repositorio (ver .gitignore).

# Clave secreta para firmar las sesiones de Flask. Cambiar por un valor
# propio y aleatorio antes de usar en un entorno real.
SECRET_KEY=cambiar-esta-clave-por-una-propia-y-aleatoria

# Modo debug de Flask: True en desarrollo, False en producción.
FLASK_DEBUG=True

# Duración de la sesión de usuario, en minutos.
SESSION_LIFETIME_MINUTES=120

# Porcentajes usados para clasificar el estado del stock respecto al stock mínimo.
STOCK_BAJO_PORCENTAJE=0.5
STOCK_CRITICO_PORCENTAJE=0.2
